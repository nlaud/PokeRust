# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Local scratch (API smoke-test artifacts)
.tmp/

# On-disk sprite cache written by the server's /api/sprites proxy
sprite_cache/

# Scraped championsbattledata.com meta stats cache -- regenerated on demand by
# meta_scraper/update_meta.py, never committed (see meta_scraper/README.md)
meta_scraper/data/

# Python bytecode cache (first networked/executed Python in this repo, as of
# meta_scraper/)
__pycache__/
*.pyc

# Loop state for the /discord-todo skill: the active task, its stage, and the
# pending plan. Local to one checkout, never committed.
.claude/discord-todo/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/